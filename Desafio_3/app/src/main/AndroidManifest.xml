<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos para acceso a Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo2"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_logo2_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CountriesWeather"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- MainActivity - Pantalla de Regiones -->
        <activity
            android:name=".view.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CountriesActivity - Pantalla de Países por Región -->
        <activity
            android:name=".view.CountriesActivity"
            android:exported="false"
            android:parentActivityName=".view.MainActivity" />

        <!-- CountryDetailActivity - Pantalla de Detalle del País -->
        <activity
            android:name=".view.CountryDetailActivity"
            android:exported="false"
            android:parentActivityName=".view.CountriesActivity" />

    </application>

</manifest>